# Public application URL used for canonical links and server redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Local development persistence. Production must use a managed database URL.
DATABASE_URL=file:./data/reign.db

# Required outside development. Generate at least 32 random bytes.
AUTH_SECRET=

# Explicit seed credentials; never reuse these values in production.
SEED_ADMIN_EMAIL=admin@reign.local
SEED_ADMIN_PASSWORD=

# Development adapters are the only credential-free provider mode.
PAYMENT_PROVIDER=development
EMAIL_PROVIDER=development

# --- AI commercial agent (Claude / Anthropic) ---
# Without a key the agent falls back to a deterministic rule-based engine.
ANTHROPIC_API_KEY=
# Optional overrides. Use claude-haiku-4-5 or claude-sonnet-5 to lower cost/latency.
AI_AGENT_MODEL=claude-opus-5
AI_AGENT_ENABLED=true

# --- Voice-note transcription (optional, OpenAI-compatible /audio/transcriptions) ---
# Enables reading WhatsApp voice notes. Works with OpenAI, Groq, or any compatible server.
# Without a key, voice notes trigger a polite "please write or re-record" reply.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- WhatsApp Business Cloud API (Meta) ---
# Token used to verify the Meta webhook subscription (you choose this value).
WHATSAPP_VERIFY_TOKEN=
# Permanent/system-user access token from the Meta app.
WHATSAPP_ACCESS_TOKEN=
# Phone number id of the WhatsApp Business number.
WHATSAPP_PHONE_NUMBER_ID=
# App secret used to validate the X-Hub-Signature-256 webhook signature.
WHATSAPP_APP_SECRET=
# Graph API version used for outbound sends.
WHATSAPP_GRAPH_VERSION=v21.0
